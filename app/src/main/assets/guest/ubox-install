#!/bin/bash
# 设置页的安装入口。用法:
#   ubox-install apt <包...>      ubox-install apt-remove <包...>
#   ubox-install npm <包...>      ubox-install npm-remove <包...>
#   ubox-install node [主版本]
#   ubox-install uv
#   ubox-install go
#   ubox-install gradle
#   ubox-install android-sdk [remove]
set -uo pipefail
export DEBIAN_FRONTEND=noninteractive
umask 022
kind="${1:-}"; shift || true

# 上次安装被中断（应用被杀、手机重启）时 dpkg 会停在半配置状态，先自动修复
repair_dpkg() {
  if [ -n "$(ls -A /var/lib/dpkg/updates 2>/dev/null)" ] || dpkg --audit 2>/dev/null | grep -q .; then
    echo "==> 检测到上次安装被中断，正在修复（dpkg --configure -a）"
    dpkg --configure -a
  fi
}

need_node() {
  command -v npm >/dev/null 2>&1 && return 0
  echo "==> 需要 Node.js，先安装 Node.js 22"
  ubox-node
}

case "$kind" in
  apt)        repair_dpkg; apt-get update && apt-get install -y --no-install-recommends "$@" ;;
  apt-remove) repair_dpkg; apt-get remove -y "$@" && apt-get autoremove -y ;;
  npm)        need_node && npm install -g "$@" ;;
  npm-remove) npm uninstall -g "$@" ;;
  node)       ubox-node "$@" ;;
  uv)
    # uv 用 Astral 官方脚本装到 ~/.local/bin，而该目录不在非交互 shell 的默认
    # PATH 里，设置页 command -v uv 检测不到。装完补一个软链到 /usr/local/bin
    # （同 OpenCode 的处理）。uv 依赖 python3/venv，缺失时先装 Python 3 工具链。
    command -v python3 >/dev/null 2>&1 || { echo "==> 需要 Python 3，先安装"; ubox-install apt python3 python3-venv; }
    curl -LsSf https://astral.sh/uv/install.sh | sh
    command -v uv >/dev/null 2>&1 || ln -sf "$HOME/.local/bin/uv" /usr/local/bin/uv
    uv --version
    ;;
  go)
    # Go 走官方 linux-arm64 tarball（apt 的 golang-go 版本旧）。解压到 /usr/local/go，
    # 软链 go 到 /usr/local/bin。优先 Go 官方中国站，失败回退阿里云镜像。
    GO_VER=1.27.4
    GO_TGZ="go${GO_VER}.linux-arm64.tar.gz"
    GO_SHA=3392582988a273a87ab5043ee1b2c9c17a2c3c00580bf9326c47a2e0aaaeac92
    if command -v go >/dev/null 2>&1; then echo "==> Go 已安装: $(go version)"; exit 0; fi
    echo "==> 下载 Go ${GO_VER} (linux-arm64)"
    tmp=$(mktemp -d)
    for base in "https://golang.google.cn/dl" "https://mirrors.aliyun.com/golang"; do
      echo "==> 尝试 ${base}"
      if curl -fL "$base/$GO_TGZ" -o "$tmp/$GO_TGZ"; then break; fi
    done
    echo "==> 校验 sha256"
    echo "${GO_SHA}  $tmp/$GO_TGZ" | sha256sum -c - || { rm -rf "$tmp"; exit 1; }
    rm -rf /usr/local/go && tar -C /usr/local -xzf "$tmp/$GO_TGZ" && rm -rf "$tmp"
    ln -sf /usr/local/go/bin/go /usr/local/bin/go
    ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt
    go version
    ;;
  gradle)
    # Gradle 9 不在 apt 源里（自带版本太旧），走官方 bin 分发包。纯 Java 程序，
    # 与 CPU 架构无关；解压到 /usr/local/gradle，软链 gradle 到 /usr/local/bin。
    # 优先腾讯云镜像（国内快），校验失败回退官方站；sha256 校验防篡改。
    GRADLE_VER=9.9.2
    GRADLE_ZIP="gradle-${GRADLE_VER}-bin.zip"
    GRADLE_SHA=971fcd7150ca4ba04852c0b2ca0d2d0ab9468e14b03473eab19528809914c76b
    # 已安装判断以能否实际运行且为 9.x 为准；版本不符或跑不起来就重装，避免坏安装无法自愈
    if [ -x /usr/local/gradle/bin/gradle ]; then
      installed_version=$(/usr/local/gradle/bin/gradle --version 2>/dev/null | grep -m1 '^Gradle ' || true)
      case "$installed_version" in
        "Gradle 9."*) echo "==> Gradle 已安装: $installed_version"; exit 0 ;;
      esac
      echo "==> 现有 Gradle 不可用或版本不符（${installed_version:-无输出}），重新安装"
      rm -rf /usr/local/gradle /usr/local/bin/gradle
    fi
    # Gradle 9 需要 JVM 17–27；仅检测 java 是否存在不够，低版本会导致装完跑不起来
    java_major=0
    command -v java >/dev/null 2>&1 &&
      java_major=$(java -version 2>&1 | head -n1 | awk -F'"' '{print $2}' | awk -F. '{if ($1==1) print $2; else print $1}')
    case "$java_major" in ''|*[!0-9]*) java_major=0 ;; esac
    if [ "$java_major" -lt 17 ]; then
      echo "==> 需要 Java 17+（当前 ${java_major}），先安装 OpenJDK 17"
      ubox-install apt openjdk-17-jdk-headless
    fi
    command -v unzip >/dev/null 2>&1 || ubox-install apt unzip
    echo "==> 下载 Gradle ${GRADLE_VER}"
    tmp=$(mktemp -d)
    ok=0
    for base in "https://mirrors.cloud.tencent.com/gradle" "https://services.gradle.org/distributions"; do
      echo "==> 尝试 ${base}"
      curl -fL "$base/$GRADLE_ZIP" -o "$tmp/$GRADLE_ZIP" || continue
      if echo "${GRADLE_SHA}  $tmp/$GRADLE_ZIP" | sha256sum -c -; then ok=1; break; fi
      echo "==> 校验和不匹配，换下一个源"
    done
    [ "$ok" = 1 ] || { echo "==> 下载/校验失败"; rm -rf "$tmp"; exit 1; }
    unzip -q "$tmp/$GRADLE_ZIP" -d "$tmp"
    rm -rf /usr/local/gradle && mv "$tmp/gradle-$GRADLE_VER" /usr/local/gradle && rm -rf "$tmp"
    ln -sf /usr/local/gradle/bin/gradle /usr/local/bin/gradle
    gradle --version
    ;;
  android-sdk) ubox-android-sdk "$@" ;;
  *) echo "未知类型: $kind"; exit 2 ;;
esac
rc=$?
echo
if [ $rc -eq 0 ]; then echo "✅ 完成"; else echo "❌ 失败（退出码 $rc），上面是错误输出"; fi
echo "按回车关闭此会话，返回设置页可查看安装状态"
exit $rc
