#!/bin/sh
# 切换 Go 模块代理（GOPROXY）。设置页「GO 源」用。
# GOPROXY 是环境变量（不是 pip/uv 那种配置文件），持久化到 /etc/profile.d/goproxy.sh，
# 该目录脚本登录时被 source。官方 proxy.golang.org 国内不通，切 goproxy.cn 加速。
# 同时设 GOSUMDB：官方/七牛云都用 sum.golang.org 校验和（goproxy.cn 会缓存校验和数据库）。
set -e
case "${1:-}" in
  official) P=https://proxy.golang.org,direct ;;
  goproxy)  P=https://goproxy.cn,direct ;;
  *) echo "用法: ubox-goproxy official|goproxy"; exit 1 ;;
esac

mkdir -p /etc/profile.d
cat > /etc/profile.d/goproxy.sh <<EOF
# Go 模块代理（设置页「GO 源」写入）
export GOPROXY=$P
export GOSUMDB=sum.golang.org
EOF
chmod 0644 /etc/profile.d/goproxy.sh

# 已装 Go 时同步 go env，让当前 shell 不重新登录也生效（go env -w 优先级高于环境变量）
if command -v go >/dev/null 2>&1; then
  go env -w GOPROXY="$P" GOSUMDB=sum.golang.org
fi

echo "GO 源已切换到 $P"
